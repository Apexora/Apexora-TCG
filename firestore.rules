rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // (aquí van tus reglas de players/ y config/ tal como las tienes)

    // ---- Juego de cartas online ----
    match /tcgGames/{gameId} {
      function game() { return get(/databases/$(database)/documents/tcgGames/$(gameId)).data; }
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['host', 'guest', 'seed', 'status', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.seed is int
        && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.guest == null
        && request.auth.uid != resource.data.host
        && request.resource.data.guest == request.auth.uid
        && request.resource.data.status == 'playing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'status']);
      allow delete: if false;
      match /moves/{n} {
        allow read: if request.auth != null && (request.auth.uid == game().host || request.auth.uid == game().guest);
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['by', 'action', 't'])
          && request.resource.data.by == request.auth.uid
          && game().status == 'playing'
          && (request.auth.uid == game().host || request.auth.uid == game().guest)
          && (n == '0' || exists(/databases/$(database)/documents/tcgGames/$(gameId)/moves/$(string(int(n) - 1))));
        allow update, delete: if false;
      }
    }
  }
}
